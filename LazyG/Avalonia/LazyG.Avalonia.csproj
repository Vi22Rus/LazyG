<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LazyG</AssemblyName>
    <RootNamespace>LazyG.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>
  <!-- Only connector/HID and diagnostic trace from the former Engine tree
       are compiled. All XML, GCD, rotation, aura and Hunter evaluators are excluded. -->
  <ItemGroup>
    <Compile Remove="Engine/**/*.cs" />
    <Compile Remove="Diagnostics/**/*.cs" />
    <Compile Remove="ForeverGameStateBridge.cs" />
    <Compile Include="Engine/GHubDriver.cs" />
    <Compile Include="Engine/RotationExecutionTrace.cs" />
    <Compile Include="Diagnostics/CrashReportService.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Experiments/LazyGConnector/LazyGConnector/NativeBindings.lua" LogicalName="LazyG.Connector.NativeBindings.lua" />
    <EmbeddedResource Include="../Experiments/LazyGConnector/LazyGConnector/Connector.lua" LogicalName="LazyG.Connector.Connector.lua" />
    <EmbeddedResource Include="Assets/icon-pack.txt" LogicalName="LazyG.IconPack" />
    <EmbeddedResource Include="Assets/class-icons.txt" LogicalName="LazyG.ClassIcons" />
    <EmbeddedResource Include="Assets/midnight-backdrop.txt" LogicalName="LazyG.MidnightBackdrop" />
    <EmbeddedResource Include="Assets/forever-spells.txt" LogicalName="LazyG.ForeverSpellCatalog" />
    <EmbeddedResource Include="Assets/forever-spell-atlas.txt" LogicalName="LazyG.ForeverSpellAtlas" />
    <Compile Include="../Windows/LazyGCoreRgbCodec.cs" Link="Bridge/LazyGCoreRgbCodec.cs" />
    <Compile Include="../Windows/WowRgbBridge.cs" Link="Bridge/WowRgbBridge.cs" />
  </ItemGroup>
</Project>