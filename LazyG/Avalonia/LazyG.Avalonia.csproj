<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LazyG</AssemblyName>
    <RootNamespace>LazyG.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../AddonTemplate/RgbV3Encoder.lua" LogicalName="LazyG.RgbV3Encoder.lua" />
    <EmbeddedResource Include="../Rotations/Forever/Examples/diagnostic-hunter.xml" LogicalName="LazyG.ForeverXmlDiagnosticExample" />
    <EmbeddedResource Include="../AddonTemplate/RgbV3Panel.lua" LogicalName="LazyG.RgbV3Panel.lua" />
    <EmbeddedResource Include="../AddonTemplate/RgbV3Thresholds.lua" LogicalName="LazyG.RgbV3Thresholds.lua" />
    <EmbeddedResource Include="../AddonTemplate/Panel.lua" LogicalName="LazyG.Panel.lua" />
    <EmbeddedResource Include="../AddonTemplate/HunterProfile.lua" LogicalName="LazyG.HunterProfile.lua" />
    <EmbeddedResource Include="Assets/icon-pack.txt" LogicalName="LazyG.IconPack" />
    <EmbeddedResource Include="Assets/class-icons.txt" LogicalName="LazyG.ClassIcons" />
    <EmbeddedResource Include="Assets/midnight-backdrop.txt" LogicalName="LazyG.MidnightBackdrop" />
    <EmbeddedResource Include="Assets/forever-spells.txt" LogicalName="LazyG.ForeverSpellCatalog" />
    <EmbeddedResource Include="Assets/forever-spell-atlas.txt" LogicalName="LazyG.ForeverSpellAtlas" />
    <Compile Include="../Windows/AddonTemplate.cs" Link="Bridge/AddonTemplate.cs" />
    <Compile Include="../Windows/RgbPanelDetector.cs" Link="Bridge/RgbPanelDetector.cs" />
    <Compile Include="../Windows/RgbV3Codec.cs" Link="Bridge/RgbV3Codec.cs" />
    <Compile Include="../Windows/RgbV3PanelDetector.cs" Link="Bridge/RgbV3PanelDetector.cs" />
    <Compile Include="../Windows/RgbV3ThresholdDetector.cs" Link="Bridge/RgbV3ThresholdDetector.cs" />
    <Compile Include="../Windows/WowRgbBridge.cs" Link="Bridge/WowRgbBridge.cs" />
    <Compile Include="../Windows/RgbSpellProbeDetector.cs" Link="Bridge/RgbSpellProbeDetector.cs" />
  </ItemGroup>
</Project>