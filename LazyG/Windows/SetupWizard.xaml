<Window x:Class="LazyGPrototype.SetupWizard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LazyG · Setup" Width="660" Height="480" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#191513" Foreground="#F8EEE8" FontFamily="Segoe UI">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="StepLabel" Text="Step 1 / 6" Foreground="#F5AD6B" FontSize="13"/>
   <TextBlock x:Name="StepTitle" Text="Choose AddOns directory" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,9"/>
   <Border Background="#604333" Height="1" Margin="0,0,0,16"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <StackPanel x:Name="PathPanel">
    <TextBlock Text="Select the exact Interface\AddOns directory of your WoW Forever client. WoW.exe is not required." TextWrapping="Wrap" Margin="0,0,0,16"/>
    <TextBox x:Name="FolderText" Height="34" VerticalContentAlignment="Center"/>
    <Button Content="Browse AddOns..." HorizontalAlignment="Left" Click="Browse_Click" Margin="0,12,0,0"/>
   </StackPanel>
   <StackPanel x:Name="NamePanel" Visibility="Collapsed">
    <TextBlock Text="Choose your own addon name (letters, numbers or underscore). Use a unique, non-impersonating name." Margin="0,0,0,10"/>
    <TextBox x:Name="AddonName" Text="LazyGPanel" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
    <TextBlock Text="WoW client version" Margin="0,0,0,8"/>
    <ComboBox x:Name="ClientVersion" Height="34" Width="320" HorizontalAlignment="Left" SelectionChanged="ClientVersion_SelectionChanged">
     <ComboBoxItem Content="WoW Forever (1.60.x)" Tag="16001" IsSelected="True"/>
     <ComboBoxItem Content="Retail / Midnight (12.1.5)" Tag="120105"/>
     <ComboBoxItem Content="Classic Era (1.15.9)" Tag="11509"/>
     <ComboBoxItem Content="Mists of Pandaria Classic (5.5.4)" Tag="50504"/>
     <ComboBoxItem Content="Burning Crusade Classic Anniversary (2.5.6)" Tag="20506"/>
     <ComboBoxItem Content="Wrath of the Lich King (3.3.5a)" Tag="30300"/>
     <ComboBoxItem Content="Other / custom Interface number" Tag="custom"/>
    </ComboBox>
    <StackPanel x:Name="CustomInterfacePanel" Visibility="Collapsed" Margin="0,9,0,0">
     <TextBlock Text="Custom Interface number (from /dump select(4, GetBuildInfo()))" Margin="0,0,0,5"/>
     <TextBox x:Name="InterfaceNumber" Height="32" Width="150" HorizontalAlignment="Left" MaxLength="7"/>
    </StackPanel>
    <TextBlock Text="Client versions may change after updates; check the .toc version in-game if the addon is marked out-of-date." TextWrapping="Wrap" Foreground="#B6A49A" Margin="0,11,0,0"/>
   </StackPanel>
   <StackPanel x:Name="InstallPanel" Visibility="Collapsed">
    <TextBlock Text="Ready to install your RGB calibration addon." Margin="0,0,0,12"/>
    <TextBlock x:Name="InstallSummary" Foreground="#B6A49A" Margin="0,0,0,16"/>
    <TextBlock Text="Existing addon folders are never overwritten. Change the addon name to create a separate installation." Foreground="#F6BA78"/>
   </StackPanel>
   <StackPanel x:Name="GamePanel" Visibility="Collapsed">
    <TextBlock Text="Launch WoW Forever, log in to a character and confirm the addon appears in the AddOns list." Margin="0,0,0,13"/>
    <TextBlock Text="If it is marked out-of-date, verify the Interface number entered at step 2." Foreground="#F6BA78" Margin="0,0,0,13"/>
    <TextBlock Text="Click Next to check that a WoW client process is running. No PID or executable path is stored." TextWrapping="Wrap"/>
    <TextBlock x:Name="GameCheckText" Text="Waiting for game check" Foreground="#F6BA78" Margin="0,15,0,0"/>
   </StackPanel>
   <StackPanel x:Name="DragPanel" Visibility="Collapsed">
    <TextBlock Text="In WoW, hold Shift and drag the RGB bar with the left mouse button to the desired position." Margin="0,0,0,15"/>
    <Button Content="Show WoW to position panel" Click="ShowGame_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/>
    <TextBlock Text="Keep the compact RGB bar unobstructed. Include the first and last marker when selecting the region." Foreground="#B6A49A" Margin="0,0,0,15"/>
    <Button Content="Select RGB region on screen" Click="SelectRegion_Click" HorizontalAlignment="Left"/>
    <TextBlock x:Name="RegionText" Text="No region selected" Foreground="#F6BA78" Margin="0,13,0,0"/>
   </StackPanel>
   <StackPanel x:Name="TestPanel" Visibility="Collapsed">
    <TextBlock Text="Connection Test minimizes Setup and searches for the complete 3×3-cell calibration pattern anywhere in the selected region." TextWrapping="Wrap" Margin="0,0,0,14"/>
    <WrapPanel>
     <Button Content="Run Connection Test" Click="Test_Click" Margin="0,0,10,0"/>
     <Button Content="Reselect RGB region" Click="Reselect_Click"/>
    </WrapPanel>
    <TextBlock x:Name="TestResult" Text="Not tested" Foreground="#F6BA78" FontWeight="SemiBold" Margin="0,15,0,0"/>
    <TextBlock Text="This tests screen capture only. It does not verify game actions or rotation calculations." Foreground="#B6A49A" Margin="0,15,0,0"/>
   </StackPanel>
  </Grid>
  <DockPanel Grid.Row="2" LastChildFill="False">
    <Button x:Name="NextButton" DockPanel.Dock="Right" Content="Next" Click="Next_Click" Background="#E18A32" Margin="9,0,0,0" MinWidth="110"/>
    <Button DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" Margin="9,0,0,0" MinWidth="90"/>
    <Button x:Name="BackButton" DockPanel.Dock="Left" Content="Back" Click="Back_Click" MinWidth="90" IsEnabled="False"/>
  </DockPanel>
 </Grid>
</Window>
