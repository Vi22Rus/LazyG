<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LazyG</AssemblyName>
    <RootNamespace>LazyGPrototype</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../AddonTemplate/RgbV3Encoder.lua" LogicalName="LazyG.RgbV3Encoder.lua" />
    <EmbeddedResource Include="../AddonTemplate/HunterCompactManifest.lua" LogicalName="LazyG.HunterCompactManifest.lua" />
    <EmbeddedResource Include="../AddonTemplate/HunterCompactProfileEncoder.lua" LogicalName="LazyG.HunterCompactProfileEncoder.lua" />
    <EmbeddedResource Include="../AddonTemplate/HunterCompactCollector.lua" LogicalName="LazyG.HunterCompactCollector.lua" />
    <EmbeddedResource Include="../AddonTemplate/RgbV3Panel.lua" LogicalName="LazyG.RgbV3Panel.lua" />
    <EmbeddedResource Include="../AddonTemplate/RgbV3Thresholds.lua" LogicalName="LazyG.RgbV3Thresholds.lua" />
  </ItemGroup>
</Project>
