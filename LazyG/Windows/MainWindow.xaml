<Window x:Class="LazyGPrototype.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LazyG  ·  0.1.2-dev" Width="1250" Height="790" MinWidth="1040" MinHeight="660" WindowStartupLocation="CenterScreen" Background="#151312" Foreground="#F8EEE8" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#372017" Offset="0"/><GradientStop Color="#221916" Offset="0.7"/><GradientStop Color="#161312" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#452819" Offset="0"/><GradientStop Color="#2A201B" Offset="0.65"/><GradientStop Color="#1F1A18" Offset="1"/></LinearGradientBrush>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
  <Border Background="{StaticResource HeaderGradient}" BorderBrush="#443027" BorderThickness="0,0,0,1">
   <Grid Margin="27,0,27,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="39" Height="39" CornerRadius="9" Background="#F49B3B" Margin="0,0,14,0"><TextBlock Text="L" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#24150D"/></Border>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="LazyG" FontSize="27" FontWeight="Bold" Foreground="#FFF6EF"/><TextBlock Text="CONTROL CENTER  ·  DEVELOPMENT BUILD" FontSize="10" Foreground="#DE9E68"/></StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse Width="8" Height="8" Fill="#E9A247" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="OFFLINE / LOCAL UI" Foreground="#DBC3B2" VerticalAlignment="Center" FontSize="12"/>
     <Border BorderBrush="#785038" BorderThickness="1" CornerRadius="4" Padding="9,5" Margin="18,0,0,0"><TextBlock Text="0.1.2-dev" FontSize="11" Foreground="#F0AC6D"/></Border>
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="#1F1A18" BorderBrush="#4A352A" BorderThickness="0,0,0,1">
   <DockPanel Margin="22,0,22,0">
    <Button x:Name="TabDashboard" Style="{StaticResource TopTab}" Content="OVERVIEW" Click="Dashboard_Click"/>
    <Button x:Name="TabSetup" Style="{StaticResource TopTab}" Content="SETUP" Click="SetupTab_Click"/>
    <Button x:Name="TabRotations" Style="{StaticResource TopTab}" Content="ROTATIONS" Click="Rotations_Click"/>
    <Button x:Name="TabOverlay" Style="{StaticResource TopTab}" Content="OVERLAY" Click="Overlay_Click"/>
    <Button x:Name="TabSettings" Style="{StaticResource TopTab}" Content="SETTINGS" Click="Settings_Click"/>
    <Button x:Name="TabAbout" Style="{StaticResource TopTab}" Content="ABOUT" Click="About_Click"/>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2" Margin="26,19,26,17"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="PageTitle" Text="Overview" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Status and controls" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
    <Border Grid.Column="1" BorderBrush="#664934" BorderThickness="1" Background="#2B211D" CornerRadius="6" Padding="13,8" VerticalAlignment="Center"><TextBlock Text="PREVIEW  ·  NO AUTHORIZATION" FontSize="11" Foreground="#EEAD6B"/></Border>
   </Grid>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Background="{StaticResource HeroGradient}" BorderBrush="#745034" BorderThickness="1" CornerRadius="9" Padding="22" Margin="0,0,0,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Welcome to LazyG" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="A clean, modular control center for your own WoW addon." Foreground="#D3B3A0" Margin="0,8,0,13"/><TextBlock Text="Set up the addon, then calibrate the on-screen RGB panel." Foreground="#F2C393"/></StackPanel>
      <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="OPEN SETUP" MinWidth="135" VerticalAlignment="Center" Click="Setup_Click"/>
     </Grid></Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8" Padding="19"><StackPanel><TextBlock Text="GAME / ADDON" FontWeight="Bold" Foreground="#EDA96D"/><TextBlock x:Name="SetupStatus" Text="Not configured" FontSize="19" Margin="0,14,0,7"/><TextBlock Text="Installed addon status is shown after setup." Foreground="{StaticResource Muted}"/></StackPanel></Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="19"><StackPanel><TextBlock Text="RGB CONNECTION" FontWeight="Bold" Foreground="#EDA96D"/><TextBlock x:Name="ConnectionStatus" Text="Waiting for panel calibration" FontSize="17" Margin="0,14,0,7"/><TextBlock Text="The two edge markers are validated together." Foreground="{StaticResource Muted}"/></StackPanel></Border>
     </Grid>
     <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="19" Margin="0,15,0,0"><StackPanel><TextBlock Text="QUICK ACCESS" FontWeight="Bold" Foreground="#EDA96D" Margin="0,0,0,14"/><WrapPanel><Button Content="Setup wizard" Click="Setup_Click"/><Button Content="Rotation library" Click="Rotations_Click"/><Button Content="Overlay options" Click="Overlay_Click"/></WrapPanel></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="SetupPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Background="{StaticResource HeroGradient}" BorderBrush="#745034" BorderThickness="1" CornerRadius="9" Padding="23" Margin="0,0,0,15"><StackPanel><TextBlock Text="SETUP WIZARD" FontWeight="Bold" Foreground="#F3B371"/><TextBlock Text="One guided installation. No game executable is required." FontSize="20" Margin="0,11,0,16"/><Button Content="START SETUP" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="Setup_Click"/></StackPanel></Border>
     <Border Background="{StaticResource Panel}" Padding="19" CornerRadius="9"><StackPanel>
      <TextBlock Text="01     Choose AddOns folder" FontSize="16" Margin="0,0,0,13"/><Separator Background="#4E392E" Margin="0,0,0,13"/>
      <TextBlock Text="02     Choose your own addon name" FontSize="16" Margin="0,0,0,13"/><Separator Background="#4E392E" Margin="0,0,0,13"/>
      <TextBlock Text="03     Install the RGB panel addon" FontSize="16" Margin="0,0,0,13"/><Separator Background="#4E392E" Margin="0,0,0,13"/>
      <TextBlock Text="04     Launch WoW and position the panel" FontSize="16" Margin="0,0,0,13"/><Separator Background="#4E392E" Margin="0,0,0,13"/>
      <TextBlock Text="05     Select the entire RGB region" FontSize="16" Margin="0,0,0,13"/><Separator Background="#4E392E" Margin="0,0,0,13"/>
      <TextBlock Text="06     Verify both connection markers" FontSize="16"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="RotationsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Background="{StaticResource Panel}" Padding="20" CornerRadius="9" Margin="0,0,0,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="ROTATION PROFILES" FontWeight="Bold" Foreground="#F2AA67"/><TextBlock Text="Choose a class and specialization" FontSize="19" Margin="0,10,0,5"/><TextBlock Text="Preview only — no commercial profiles included." Foreground="{StaticResource Muted}"/></StackPanel>
      <ComboBox Grid.Column="1" VerticalAlignment="Center" SelectedIndex="0" IsEnabled="False"><ComboBoxItem Content="Paladin (preview)"/></ComboBox>
     </Grid></Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" Padding="20" CornerRadius="9"><StackPanel><TextBlock Text="PVE PROFILES" FontWeight="Bold" Foreground="#F2AA67" Margin="0,0,0,14"/><TextBlock Text="Holy" Margin="0,0,0,13"/><TextBlock Text="Protection" Margin="0,0,0,13"/><TextBlock Text="Retribution"/><TextBlock Text="Profile selection will be implemented later." Foreground="{StaticResource Muted}" Margin="0,21,0,0"/></StackPanel></Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" Padding="20" CornerRadius="9"><StackPanel><TextBlock Text="PVP PROFILES" FontWeight="Bold" Foreground="#F2AA67" Margin="0,0,0,14"/><TextBlock Text="Holy" Margin="0,0,0,13"/><TextBlock Text="Protection" Margin="0,0,0,13"/><TextBlock Text="Retribution"/><TextBlock Text="No rotation logic in this UI build." Foreground="{StaticResource Muted}" Margin="0,21,0,0"/></StackPanel></Border>
     </Grid>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="OverlayPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Background="{StaticResource Panel}" Padding="22" CornerRadius="9" Margin="0,0,0,15"><StackPanel><TextBlock Text="OVERLAY CONTROLS" FontWeight="Bold" Foreground="#F2AA67"/><TextBlock Text="Movement mode" FontSize="20" Margin="0,12,0,15"/>
      <WrapPanel><Button x:Name="StationaryButton" Content="STATIONARY ONLY" Click="Stationary_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="MovingButton" Content="MOVING ALLOWED" Click="Moving_Click"/></WrapPanel>
      <TextBlock x:Name="MovementModeText" Text="Preview mode: stationary only" Foreground="#EFB37B" Margin="0,14,0,0"/>
      <TextBlock Text="These buttons only demonstrate UI state; no game commands are sent." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
     </StackPanel></Border>
     <Border Background="{StaticResource Panel}" CornerRadius="9" Padding="22"><StackPanel><TextBlock Text="RGB PANEL" FontWeight="Bold" Foreground="#F2AA67" Margin="0,0,0,12"/><TextBlock Text="The calibration addon uses a fixed left and right marker." Foreground="{StaticResource Muted}" Margin="0,0,0,15"/><Grid Height="40"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><Border Background="Lime"/><Border Grid.Column="1" Background="#33383B"/><Border Grid.Column="2" Background="Magenta"/></Grid><TextBlock Text="Calibration example (not a live capture)" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Background="{StaticResource Panel}" Padding="22" CornerRadius="9" Margin="0,0,0,15"><StackPanel><TextBlock Text="APPLICATION" FontWeight="Bold" Foreground="#F2AA67" Margin="0,0,0,15"/><TextBlock Text="Language / Язык" Margin="0,0,0,8"/><ComboBox Width="230" HorizontalAlignment="Left" SelectedIndex="0" IsEnabled="False"><ComboBoxItem Content="English (prototype)"/><ComboBoxItem Content="Русский (future)"/></ComboBox><TextBlock Text="Localization controls are a preview only." Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
     <Border Background="{StaticResource Panel}" Padding="22" CornerRadius="9"><StackPanel><TextBlock Text="SYSTEM" FontWeight="Bold" Foreground="#F2AA67" Margin="0,0,0,12"/><TextBlock Text="Windows x64  ·  C# / WPF"/><TextBlock Text="No authorization, keys, hardware identifiers or server access." Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="AboutPage" Visibility="Collapsed"><Border Background="{StaticResource Panel}" Padding="23" CornerRadius="9"><StackPanel><TextBlock Text="LazyG" FontSize="28" FontWeight="Bold"/><TextBlock Text="Independent UI development prototype" Foreground="#E9A65F" Margin="0,7,0,13"/><TextBlock Text="Original interface implementation. No WarMate DLLs, images or fonts are included." Foreground="{StaticResource Muted}"/></StackPanel></Border></ScrollViewer>
   </Grid>
  </Grid>
  <Border Grid.Row="3" Background="#1D1816" BorderBrush="#493328" BorderThickness="0,1,0,0"><Grid Margin="26,0,26,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="LazyG  ·  User interface preview" VerticalAlignment="Center" Foreground="#97867B" FontSize="11"/><TextBlock Grid.Column="1" Text="No rotation engine  ·  No input automation" VerticalAlignment="Center" Foreground="#97867B" FontSize="11"/></Grid></Border>
 </Grid>
</Window>