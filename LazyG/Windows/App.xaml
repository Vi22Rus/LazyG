<Application x:Class="LazyGPrototype.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#211B1A"/>
  <SolidColorBrush x:Key="PanelAlt" Color="#2C2421"/>
  <SolidColorBrush x:Key="Muted" Color="#B3A39A"/>
  <SolidColorBrush x:Key="Accent" Color="#F49B3B"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#342B27"/><Setter Property="Foreground" Value="#F5EAE2"/>
   <Setter Property="BorderBrush" Value="#55423A"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,10,0"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="TopTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="17,15"/>
   <Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="13"/>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#E18A32"/><Setter Property="Foreground" Value="#20130C"/>
   <Setter Property="BorderBrush" Value="#FFB96B"/>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#332927"/><Setter Property="Foreground" Value="#20130C"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#302624"/><Setter Property="Foreground" Value="#F7EAE0"/><Setter Property="BorderBrush" Value="#675246"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F5EAE2"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
 </Application.Resources>
</Application>