<?xml version="1.0" encoding="utf-8"?>
<!-- EXPERIMENTAL OFFLINE-only. PowerPercent is NOT absolute Rage; not a live Arms priority. -->
<Rotation version="2" client="forever" classId="1" specIndex="1" mode="PvE">
  <Settings>
    <Setting id="useMortalStrike" type="bool" unit="toggle" default="1" min="0" max="1" step="1" tier="Essentials" group="Rotation" ru="Использовать Смертельный удар" en="Use Mortal Strike"/>
    <Setting id="limitByPowerPercent" type="bool" unit="toggle" default="0" min="0" max="1" step="1" tier="Advanced" group="Rotation" ru="Ограничить по доле ресурса (только симулятор)" en="Limit by power percent (simulator only)"/>
    <Setting id="powerPercentMin" type="int" unit="percent" default="50" min="0" max="100" step="5" tier="Advanced" group="Rotation" ru="Минимальная доля ресурса (не ярость в единицах)" en="Min resource percentage (not Rage units)"/>
  </Settings>
  <Rules>
    <Rule id="armsMortalStrike" priority="10" spellId="12294" enabledBy="useMortalStrike">
      <Condition signal="PowerPercent" compare="AtLeast" settingRef="powerPercentMin" whenEnabled="limitByPowerPercent"/>
    </Rule>
  </Rules>
</Rotation>
