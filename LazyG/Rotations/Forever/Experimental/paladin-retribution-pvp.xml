<?xml version="1.0" encoding="utf-8"?>
<!-- EXPERIMENTAL OFFLINE-only. WoW Forever Paladin spell ranks must be validated in-game. -->
<Rotation version="2" client="forever" classId="2" specIndex="3" mode="PvP">
  <Settings>
    <Setting id="useHammerOfJustice" type="bool" unit="toggle" default="1" min="0" max="1" step="1" tier="Essentials" group="Control" ru="Использовать Молот правосудия" en="Use Hammer of Justice"/>
    <Setting id="onlyLowHpHammer" type="bool" unit="toggle" default="0" min="0" max="1" step="1" tier="Advanced" group="Control" ru="Ограничивать оглушение низким HP цели" en="Restrict stun to low target HP"/>
    <Setting id="hammerHpThreshold" type="int" unit="percent" default="20" min="5" max="100" step="5" tier="Advanced" group="Control" ru="HP цели для ограничения оглушения" en="Target HP for conditional stun"/>
  </Settings>
  <Rules>
    <Rule id="pvpHammerOfJustice" priority="10" spellId="853" enabledBy="useHammerOfJustice">
      <Condition signal="TargetHealthPercent" compare="Below" settingRef="hammerHpThreshold" whenEnabled="onlyLowHpHammer"/>
    </Rule>
  </Rules>
</Rotation>
